rules_version = '2';
// Fase 1: todo cerrado. Nadie lee ni escribe hasta que la Fase 2 defina los perfiles (dueño, externo, pesaje).
// Patrón del proyecto: todo prohibido salvo lo que se permita expresamente, y cada cambio probado con el emulador.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
