rules_version = '2';

// Panadería · reglas por perfil (Fase 2), forma de los datos del catálogo (Fase 3) y del pesaje (Fase 4). Todo lo que no se permite aquí queda prohibido.
// Perfiles: DUEÑO (su UID figura en config/negocio, creado a mano en la consola), EXTERNO y PESAJE (miembros/{uid}, los crea un dueño).
// «Gestión» = dueño o externo. La cuenta de pesaje nunca lee precios, cierres, proyecciones ni costos (los clientes sí desde la Fase 11:
// solo nombre, activo y tipo, sin montos, para elegir «Para:» en la tablet).
// Cada cambio se prueba con el emulador: tests/rules-emulator.js (casos en tests/reglas-casos.js).
// Fase 6: cierres mensuales. Fase 7: forma de la proyección y las metas. Fase 9: insumos, precios de insumos, recetas y gastos del mes.
// Fase 10: plan de producción del día (la tablet lee solo el de hoy y no escribe).
// Fase 11: varios clientes y ventas sueltas: `tipo` en clientes, `clienteId` en pesajes, dias/{fecha}_{clienteId}, cierres por cliente.
// Fase 12: cobros y cotizaciones (config/empresa, config/folios, clientesCobro, cobros, abonos, cotizaciones): solo dueños y externo.
// Revisión del 25-nov-2026 (solo reglas y pruebas; la app sigue en 0.12.0): sesión solo de Google y con correo verificado, bitácora más cerrada, fechas estrictas y sin
// futuro, mes terminado con la hora de invierno y tope por canasto en la tablet (ver decisiones/revision-reglas-2026-11.md).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Quién es quién ----------
    // Endurecimiento (revisión del 25-nov-2026): solo cuenta con sesión de GOOGLE y correo verificado. La app entra siempre con Google
    // (signInWithCredential con el id_token); si algún día se activara otro método en la consola (anónimo, correo y clave), esa cuenta
    // no pasaría ninguna regla.
    function sesion() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }
    function esDueno() {
      return sesion()
        && exists(/databases/$(database)/documents/config/negocio)
        && request.auth.uid in get(/databases/$(database)/documents/config/negocio).data.duenos;
    }
    function tienePerfil(p) {
      return sesion()
        && exists(/databases/$(database)/documents/miembros/$(request.auth.uid))
        && get(/databases/$(database)/documents/miembros/$(request.auth.uid)).data.activo == true
        && get(/databases/$(database)/documents/miembros/$(request.auth.uid)).data.perfil == p;
    }
    function esGestion() { return esDueno() || tienePerfil('externo'); }
    function esPesaje() { return tienePerfil('pesaje'); }
    function conAcceso() { return esGestion() || esPesaje(); }

    // ---------- Ayudas ----------
    function nuevo() { return request.resource.data; }
    function texto(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    // Fecha AAAA-MM-DD con mes 01 a 12 y día 01 a 31 (no revisa que el día exista en el mes: 30 de febrero pasa; 2026-99-99 no).
    function fechaValida(f) { return f is string && f.size() == 10 && f.matches('20[0-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])'); }
    function dosDigitos(n) { return n < 10 ? '0' + string(n) : string(n); }
    function diaDe(t) { return string(t.year()) + '-' + dosDigitos(t.month()) + '-' + dosDigitos(t.day()); }
    // Día calendario chileno según la hora del SERVIDOR. Chile continental está a 3 o 4 horas de UTC según la época del año:
    // se aceptan ambas (solo difieren durante una hora, alrededor de la medianoche).
    function esHoy(fecha) {
      return fecha == diaDe(request.time - duration.value(3, 'h')) || fecha == diaDe(request.time - duration.value(4, 'h'));
    }
    // Mañana (Fase 10, plan de producción), con la misma holgura de la medianoche que esHoy: el día de hoy + 24 horas.
    function esManana(fecha) {
      return fecha == diaDe(request.time + duration.value(21, 'h')) || fecha == diaDe(request.time + duration.value(20, 'h'));
    }

    // ---------- Negocio ----------
    // Lista de dueños, nombre e IVA. Se crea a mano en la consola: nadie puede nombrarse dueño desde la app.
    match /config/negocio {
      allow read: if sesion();
      allow create, delete: if false;
      // Un dueño puede ajustar el nombre y el IVA; la lista de dueños solo se cambia en la consola.
      allow update: if esDueno()
        && nuevo().diff(resource.data).affectedKeys().hasOnly(['nombre', 'iva'])
        && texto(nuevo().nombre, 1, 60)
        && nuevo().iva is number && nuevo().iva >= 0 && nuevo().iva <= 100;
    }
    // Último respaldo descargado (Fase 5): lo anota quien descarga, para la franja de aviso semanal. Nada de esto lo ve la tablet.
    match /config/respaldo {
      allow read: if esGestion();
      allow create, update: if esGestion()
        && nuevo().keys().hasOnly(['por', 'quien', 'conteos', 'lecturas', 'en'])
        && nuevo().keys().hasAll(['por', 'quien', 'conteos', 'lecturas', 'en'])
        && nuevo().por == request.auth.uid
        && texto(nuevo().quien, 1, 60)
        && nuevo().conteos is map
        && nuevo().lecturas is int && nuevo().lecturas >= 0
        && nuevo().en == request.time;
      allow delete: if false;
    }

    // ---------- Solicitudes de acceso ----------
    // Cada persona crea la suya, con su propio correo de Google y la hora del servidor. No se modifican: se aprueban (pasan a miembros) o se borran.
    match /solicitudes/{uid} {
      allow get: if sesion() && (request.auth.uid == uid || esDueno());
      allow list: if esDueno();
      allow create: if sesion() && request.auth.uid == uid
        && nuevo().keys().hasOnly(['nombre', 'correo', 'creado'])
        && nuevo().keys().hasAll(['nombre', 'correo', 'creado'])
        && texto(nuevo().nombre, 2, 60)
        && request.auth.token.email_verified == true
        && nuevo().correo == request.auth.token.email
        && nuevo().creado == request.time;
      allow update: if false;
      allow delete: if sesion() && (request.auth.uid == uid || esDueno());
    }

    // ---------- Miembros (externo y pesaje) ----------
    // Solo los dueños aprueban, cambian el perfil y quitan accesos. Cada persona lee solo su propia ficha.
    match /miembros/{uid} {
      allow get: if sesion() && (request.auth.uid == uid || esDueno());
      allow list: if esDueno();
      allow create, update: if esDueno()
        && nuevo().keys().hasOnly(['nombre', 'correo', 'perfil', 'activo', 'por', 'en'])
        && nuevo().keys().hasAll(['nombre', 'correo', 'perfil', 'activo', 'por', 'en'])
        && texto(nuevo().nombre, 2, 60)
        && texto(nuevo().correo, 3, 200)
        && nuevo().perfil in ['externo', 'pesaje']
        && nuevo().activo is bool
        && nuevo().por == request.auth.uid
        && nuevo().en == request.time;
      allow delete: if esDueno();
    }

    // ---------- Catálogo (Fase 3) ----------
    // Productos: se venden por kilo o por unidad, y eso no cambia después de creados (los precios y pesajes dependen de la unidad).
    // pesoRef = gramos de referencia por unidad (solo para los que se venden por unidad). No se borran: se desactivan.
    function productoValido() {
      return nuevo().keys().hasOnly(['nombre', 'unidad', 'pesoRef', 'categoria', 'orden', 'activo', 'en'])
        && nuevo().keys().hasAll(['nombre', 'unidad', 'activo', 'en'])
        && texto(nuevo().nombre, 1, 60)
        && nuevo().unidad in ['kg', 'un']
        && nuevo().activo is bool
        && (!('pesoRef' in nuevo()) || (nuevo().unidad == 'un' && nuevo().pesoRef is number && nuevo().pesoRef > 0 && nuevo().pesoRef <= 100000))
        && (!('categoria' in nuevo()) || texto(nuevo().categoria, 1, 40))
        && (!('orden' in nuevo()) || (nuevo().orden is number && nuevo().orden >= 0 && nuevo().orden <= 100000))
        && nuevo().en == request.time;
    }
    match /productos/{id} {
      allow read: if conAcceso();
      allow create: if esGestion() && productoValido();
      allow update: if esGestion() && productoValido() && nuevo().unidad == resource.data.unidad;
      allow delete: if false;
    }
    // Precios: internos. La cuenta de pesaje NO los lee (ni uno por uno ni en lista).
    // Cada precio rige desde su fecha (AAAA-MM-DD) para un producto y un cliente; el identificador es producto_cliente_fecha,
    // así no hay dos precios para el mismo día. Un precio nuevo no toca los anteriores: los días pasados conservan su precio.
    match /precios/{id} {
      allow read: if esGestion();
      allow create, update: if esGestion()
        && nuevo().keys().hasOnly(['productoId', 'clienteId', 'neto', 'desde', 'en'])
        && nuevo().keys().hasAll(['productoId', 'clienteId', 'neto', 'desde', 'en'])
        && texto(nuevo().productoId, 1, 60)
        && texto(nuevo().clienteId, 1, 60)
        && nuevo().neto is number && nuevo().neto > 0 && nuevo().neto <= 100000000
        && fechaValida(nuevo().desde)
        && id == nuevo().productoId + '_' + nuevo().clienteId + '_' + nuevo().desde
        && nuevo().en == request.time;
      allow delete: if esGestion();
    }
    match /trabajadores/{id} {
      allow read: if conAcceso();
      allow create, update: if esGestion()
        && nuevo().keys().hasOnly(['nombre', 'activo', 'en'])
        && nuevo().keys().hasAll(['nombre', 'activo', 'en'])
        && texto(nuevo().nombre, 1, 60)
        && nuevo().activo is bool
        && nuevo().en == request.time;
      allow delete: if false;
    }
    // Clientes (Fase 11: varios). tipo: 'regular' (o sin tipo) o 'suelta' («Ventas sueltas», uno solo: lo revisa la app). La tablet los lee
    // para elegir «Para:» (aquí no hay montos: los precios siguen siendo solo de gestión). No se borran: se desactivan.
    match /clientes/{id} {
      allow read: if conAcceso();
      allow create, update: if esGestion()
        && nuevo().keys().hasOnly(['nombre', 'activo', 'tipo', 'en'])
        && nuevo().keys().hasAll(['nombre', 'activo', 'en'])
        && texto(nuevo().nombre, 1, 60)
        && nuevo().activo is bool
        && (!('tipo' in nuevo()) || nuevo().tipo in ['regular', 'suelta'])
        && nuevo().en == request.time;
      allow delete: if false;
    }

    // ---------- Pesajes y entregas del día (Fase 4) ----------
    // Un documento por canasto. Gestión: todo (también fechas pasadas). Pesaje (la tablet): crea, y lee y corrige solo lo del día
    // según la hora del servidor. No se borran: se anulan. Los totales no se guardan: la app los calcula con los pesajes.
    // La unidad debe ser la del producto (kg o un) y el trabajador debe existir en la lista.
    // Fase 11: `clienteId` (opcional: sin él = el cliente original). Si viene NUEVO (al crear, o al cambiarlo en una corrección), el cliente
    // debe existir y estar activo; si no cambia, se acepta aunque después se haya desactivado (para corregir otra cosa de ese canasto).
    // Lo anotado sin conexión cerca de la medianoche puede llegar al servidor al día siguiente: la tablet puede CREAR con la fecha de ayer.
    function esAyer(fecha) {
      return fecha == diaDe(request.time - duration.value(27, 'h')) || fecha == diaDe(request.time - duration.value(28, 'h'));
    }
    // Revisión del 25-nov-2026: un canasto no lleva fecha futura (tope = hoy según la hora del servidor, con la holgura de la medianoche de
    // esHoy: en invierno acepta una hora de más, nunca un día) y la TABLET tiene un tope por canasto: 10 veces el aviso de la app
    // (AVISO_KG = 20), para que un «20» tipeado como «2000» no pase. Dueños y externo no tienen tope (corrigen lo que haga falta).
    function noFutura(fecha) { return fecha <= diaDe(request.time - duration.value(3, 'h')); }
    function topeTablet() {
      return (nuevo().unidad == 'kg' && nuevo().cantidad <= 200) || (nuevo().unidad == 'un' && nuevo().cantidad <= 2000);
    }
    function pesajeValido() {
      return nuevo().keys().hasOnly(['fecha', 'hora', 'entregaN', 'clienteId', 'productoId', 'cantidad', 'unidad', 'trabajadorId', 'nota', 'anulado', 'creadoPor', 'en'])
        && nuevo().keys().hasAll(['fecha', 'hora', 'entregaN', 'productoId', 'cantidad', 'unidad', 'trabajadorId', 'anulado', 'creadoPor', 'en'])
        && fechaValida(nuevo().fecha) && noFutura(nuevo().fecha)
        && nuevo().hora is string && nuevo().hora.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
        && nuevo().entregaN is int && nuevo().entregaN >= 1 && nuevo().entregaN <= 50
        && texto(nuevo().productoId, 1, 60)
        && texto(nuevo().trabajadorId, 1, 60)
        && nuevo().cantidad is number && nuevo().cantidad > 0 && nuevo().cantidad <= 100000
        && nuevo().unidad in ['kg', 'un']
        && (nuevo().unidad == 'kg' || nuevo().cantidad is int)
        && (!('nota' in nuevo()) || texto(nuevo().nota, 1, 200))
        && (!('clienteId' in nuevo()) || texto(nuevo().clienteId, 1, 60))
        && nuevo().anulado is bool
        && nuevo().en == request.time
        && get(/databases/$(database)/documents/productos/$(nuevo().productoId)).data.unidad == nuevo().unidad
        && exists(/databases/$(database)/documents/trabajadores/$(nuevo().trabajadorId));
    }
    // Fase 6: en un mes CERRADO (cierres/{AAAA-MM} con cerrado == true) dueños y externo ya no anotan ni corrigen.
    // La tablet no se revisa: solo anota hoy o ayer, y el mes en curso no se puede cerrar (lo anotado sin conexión no se pierde).
    function mesDeFecha(f) { return f.split('-')[0] + '-' + f.split('-')[1]; }
    function mesAbierto(f) {
      return !exists(/databases/$(database)/documents/cierres/$(mesDeFecha(f)))
        || get(/databases/$(database)/documents/cierres/$(mesDeFecha(f))).data.get('cerrado', false) != true;
    }
    function clienteActivo(cid) {
      return exists(/databases/$(database)/documents/clientes/$(cid))
        && get(/databases/$(database)/documents/clientes/$(cid)).data.activo == true;
    }
    function clienteAlCrear() { return !('clienteId' in nuevo()) || clienteActivo(nuevo().clienteId); }
    function clienteAlCorregir() {
      return !('clienteId' in nuevo()) || nuevo().clienteId == resource.data.get('clienteId', '') || clienteActivo(nuevo().clienteId);
    }
    match /pesajes/{id} {
      allow read: if esGestion() || (esPesaje() && esHoy(resource.data.fecha));
      allow create: if pesajeValido() && nuevo().creadoPor == request.auth.uid && clienteAlCrear()
        && ((esGestion() && mesAbierto(nuevo().fecha)) || (esPesaje() && (esHoy(nuevo().fecha) || esAyer(nuevo().fecha)) && topeTablet()));
      allow update: if pesajeValido() && nuevo().creadoPor == resource.data.creadoPor && clienteAlCorregir()
        && ((esGestion() && mesAbierto(resource.data.fecha) && mesAbierto(nuevo().fecha))
          || (esPesaje() && esHoy(resource.data.fecha) && nuevo().fecha == resource.data.fecha && topeTablet()));
      allow delete: if false;
    }
    // Entrega en curso del día: dias/{fecha} = { entregaN, por, en }. «Cerrar entrega» la sube en uno; «volver a abrir» la baja en uno.
    // La tablet solo toca el día de hoy (o el de ayer, por lo anotado sin conexión) y de a un paso; gestión puede fijar cualquier número.
    // Fase 11: cada cliente regular lleva su propia numeración. El cliente original sigue en dias/{fecha}; otro cliente, en
    // dias/{fecha}_{clienteId} (el cliente debe existir). Las mismas reglas para los dos.
    function partesDia(id) { return id.split('_'); }
    function fechaDia(id) { return partesDia(id)[0]; }
    function idDiaValido(id) {
      return fechaValida(fechaDia(id))
        && ((partesDia(id).size() == 1 && id.size() == 10)
          || (partesDia(id).size() == 2 && texto(partesDia(id)[1], 1, 60) && exists(/databases/$(database)/documents/clientes/$(partesDia(id)[1]))));
    }
    function diaValido(id) {
      return idDiaValido(id)
        && nuevo().keys().hasOnly(['entregaN', 'por', 'en'])
        && nuevo().keys().hasAll(['entregaN', 'por', 'en'])
        && nuevo().entregaN is int && nuevo().entregaN >= 1 && nuevo().entregaN <= 50
        && nuevo().por == request.auth.uid
        && nuevo().en == request.time;
    }
    function tabletEnSuDia(fecha) { return esPesaje() && (esHoy(fecha) || esAyer(fecha)); }
    match /dias/{id} {
      allow read: if esGestion() || (esPesaje() && esHoy(fechaDia(id)));
      allow create: if diaValido(id) && (esGestion() || (tabletEnSuDia(fechaDia(id)) && nuevo().entregaN <= 2));
      allow update: if diaValido(id) && (esGestion()
        || (tabletEnSuDia(fechaDia(id)) && (nuevo().entregaN == resource.data.entregaN + 1 || nuevo().entregaN == resource.data.entregaN - 1)));
      allow delete: if false;
    }

    // ---------- Ventas, cierres y proyección (pantallas: Fases 5 a 7). Nada de esto lo ve la cuenta de pesaje ----------
    // Cierre de un mes (Fase 6): cierres/{AAAA-MM}, importado desde Excel o calculado con los pesajes («Cerrar mes»).
    // Siempre se guarda cerrado, completo y a nombre de quien cierra; solo meses ya terminados. El IVA del mes es ivaMonto
    // (IVA % × neto del mes) y total = neto + ivaMonto. Un mes cerrado no se modifica: solo un DUEÑO puede reabrirlo
    // (queda constancia de quién y cuándo); reabierto, se vuelve a cerrar (o a importar) o se borra.
    // Fase 11: las líneas van por pan y por cliente (clienteId y cliente en cada línea; hasta 600) y `clientes` resume a cada uno (hasta 50).
    function mesValido(mes) { return mes.matches('20[0-9][0-9]-(0[1-9]|1[0-2])'); }
    // Con 4 horas (no 3): en horario de invierno (UTC-4) el día chileno es el de «ahora − 4 h»; con 3 horas el mes se daba por terminado
    // una hora antes (23:00 del último día de mayo, julio y agosto). En verano (UTC-3) el mes se da por terminado una hora más tarde: no importa.
    function mesTerminado(mes) { return mes + '-31' < diaDe(request.time - duration.value(4, 'h')); }
    function cierreValido(mes) {
      return mesValido(mes) && mesTerminado(mes)
        && nuevo().keys().hasOnly(['mes', 'origen', 'cerrado', 'clienteId', 'cliente', 'clientes', 'iva', 'lineas', 'neto', 'ivaMonto', 'total', 'kg', 'un',
          'canastos', 'dias', 'sinPrecio', 'archivo', 'hoja', 'reabiertoPor', 'reabiertoQuien', 'reabiertoEn', 'por', 'quien', 'en'])
        && nuevo().keys().hasAll(['mes', 'origen', 'cerrado', 'iva', 'lineas', 'neto', 'ivaMonto', 'total', 'kg', 'un', 'por', 'quien', 'en'])
        && nuevo().mes == mes
        && nuevo().origen in ['excel', 'app']
        && nuevo().cerrado == true
        && nuevo().iva is number && nuevo().iva >= 0 && nuevo().iva <= 100
        && nuevo().lineas is list && nuevo().lineas.size() >= 1 && nuevo().lineas.size() <= 600
        && (!('clientes' in nuevo()) || (nuevo().clientes is list && nuevo().clientes.size() <= 50))
        && nuevo().neto is int && nuevo().neto >= 0
        && nuevo().ivaMonto is int && nuevo().ivaMonto >= 0
        && nuevo().total == nuevo().neto + nuevo().ivaMonto
        && nuevo().kg is number && nuevo().kg >= 0
        && nuevo().un is int && nuevo().un >= 0
        && (!('clienteId' in nuevo()) || texto(nuevo().clienteId, 1, 60))
        && (!('cliente' in nuevo()) || texto(nuevo().cliente, 1, 60))
        && (!('archivo' in nuevo()) || texto(nuevo().archivo, 1, 200))
        && (!('hoja' in nuevo()) || texto(nuevo().hoja, 1, 100))
        && nuevo().por == request.auth.uid
        && texto(nuevo().quien, 1, 60)
        && nuevo().en == request.time;
    }
    function reapertura() {
      return nuevo().diff(resource.data).affectedKeys().hasOnly(['cerrado', 'reabiertoPor', 'reabiertoQuien', 'reabiertoEn', 'en'])
        && nuevo().cerrado == false
        && nuevo().reabiertoPor == request.auth.uid
        && texto(nuevo().reabiertoQuien, 1, 60)
        && nuevo().reabiertoEn == request.time
        && nuevo().en == request.time;
    }
    match /cierres/{mes} {
      allow read: if esGestion();
      allow create: if esGestion() && cierreValido(mes);
      allow update: if (esGestion() && resource.data.get('cerrado', false) != true && cierreValido(mes))
        || (esDueno() && resource.data.get('cerrado', false) == true && reapertura());
      allow delete: if esGestion() && resource.data.get('cerrado', false) != true;
    }
    // Proyección y metas de un año (Fase 7): proyeccion/{AAAA}. Factores como multiplicadores (1,05 = +5 %): crecimiento general,
    // precio y, por pan, un mapa productoId → factor. Metas: lista de 12 montos netos en pesos enteros (o null = se usa la proyección).
    // La escriben dueños y externo, a su nombre; no se borra.
    function factorValido(f) { return f is number && f > 0 && f <= 10; }
    function metaValida(v) { return v == null || (v is int && v >= 0 && v <= 100000000000); }
    function metasValidas(m) {
      return m is list && m.size() == 12
        && metaValida(m[0]) && metaValida(m[1]) && metaValida(m[2]) && metaValida(m[3]) && metaValida(m[4]) && metaValida(m[5])
        && metaValida(m[6]) && metaValida(m[7]) && metaValida(m[8]) && metaValida(m[9]) && metaValida(m[10]) && metaValida(m[11]);
    }
    function proyeccionValida(anio) {
      return anio.matches('20[0-9][0-9]')
        && nuevo().keys().hasOnly(['anio', 'factor', 'factorPrecio', 'panes', 'metas', 'por', 'quien', 'en'])
        && nuevo().keys().hasAll(['anio', 'factor', 'factorPrecio', 'panes', 'metas', 'por', 'quien', 'en'])
        && nuevo().anio is int && nuevo().anio == int(anio)
        && factorValido(nuevo().factor) && factorValido(nuevo().factorPrecio)
        && nuevo().panes is map && nuevo().panes.size() <= 200
        && metasValidas(nuevo().metas)
        && nuevo().por == request.auth.uid
        && texto(nuevo().quien, 1, 60)
        && nuevo().en == request.time;
    }
    match /proyeccion/{anio} {
      allow read: if esGestion();
      allow create, update: if esGestion() && proyeccionValida(anio);
      allow delete: if false;
    }
    // Costos (Fase 9): insumos, sus precios con vigencia, recetas por tanda con vigencia y gastos del mes. Internos como los precios:
    // solo dueños y externo (la cuenta de pesaje no los lee). Nada de esto toca las ventas ni los cierres.
    // Insumo: nombre y unidad ('kg', 'l' o 'un'); la unidad no cambia después de creado (precios y recetas dependen de ella). No se borra.
    match /insumos/{id} {
      allow read: if esGestion();
      allow create, update: if esGestion()
        && nuevo().keys().hasOnly(['nombre', 'unidad', 'activo', 'en'])
        && nuevo().keys().hasAll(['nombre', 'unidad', 'activo', 'en'])
        && texto(nuevo().nombre, 1, 60)
        && nuevo().unidad in ['kg', 'l', 'un']
        && nuevo().activo is bool
        && nuevo().en == request.time
        && (resource == null || nuevo().unidad == resource.data.unidad);
      allow delete: if false;
    }
    // Precio de un insumo: lo que dice la factura (formato = cuánto trae, en su unidad; neto = precio neto de ese formato; puede ser 0)
    // desde una fecha. Identificador insumo_fecha: no hay dos precios para el mismo día. Se puede quitar uno del historial.
    match /preciosInsumo/{id} {
      allow read, delete: if esGestion();
      allow create, update: if esGestion()
        && nuevo().keys().hasOnly(['insumoId', 'formato', 'neto', 'desde', 'en'])
        && nuevo().keys().hasAll(['insumoId', 'formato', 'neto', 'desde', 'en'])
        && texto(nuevo().insumoId, 1, 60)
        && nuevo().formato is number && nuevo().formato > 0 && nuevo().formato <= 100000
        && nuevo().neto is number && nuevo().neto >= 0 && nuevo().neto <= 100000000
        && fechaValida(nuevo().desde)
        && id == nuevo().insumoId + '_' + nuevo().desde
        && nuevo().en == request.time;
    }
    // Receta de un pan por tanda, desde una fecha (producto_fecha): ingredientes (lista de 1 a 30) y lo que sale (kilos o unidades).
    // La revisión de cada ingrediente la hace la app (core/costos.js); aquí, la forma. Se puede quitar una versión.
    match /recetas/{id} {
      allow read, delete: if esGestion();
      allow create, update: if esGestion()
        && nuevo().keys().hasOnly(['productoId', 'desde', 'items', 'rendimiento', 'nota', 'por', 'en'])
        && nuevo().keys().hasAll(['productoId', 'desde', 'items', 'rendimiento', 'por', 'en'])
        && texto(nuevo().productoId, 1, 60)
        && fechaValida(nuevo().desde)
        && id == nuevo().productoId + '_' + nuevo().desde
        && nuevo().items is list && nuevo().items.size() >= 1 && nuevo().items.size() <= 30
        && nuevo().rendimiento is number && nuevo().rendimiento > 0 && nuevo().rendimiento <= 100000
        && (!('nota' in nuevo()) || texto(nuevo().nota, 1, 200))
        && nuevo().por == request.auth.uid
        && nuevo().en == request.time;
    }
    // Gastos de un mes (gastos/{AAAA-MM}): líneas con nombre y monto (hasta 30). Se pueden corregir también en un mes cerrado
    // (no cambian las ventas). Queda quién y cuándo. No se borra (se guarda sin líneas).
    match /gastos/{mes} {
      allow read: if esGestion();
      allow create, update: if esGestion() && mesValido(mes)
        && nuevo().keys().hasOnly(['mes', 'items', 'por', 'quien', 'en'])
        && nuevo().keys().hasAll(['mes', 'items', 'por', 'quien', 'en'])
        && nuevo().mes == mes
        && nuevo().items is list && nuevo().items.size() <= 30
        && nuevo().por == request.auth.uid
        && texto(nuevo().quien, 1, 60)
        && nuevo().en == request.time;
      allow delete: if false;
    }
    // ---------- Plan de producción del día (Fase 10) ----------
    // planes/{AAAA-MM-DD} = { fecha, items: [{ productoId, cantidad, unidad, tandas }] (1 a 60), nota?, por, quien, en }: cuánto se quiere
    // pesar de cada pan ese día. Lo arman, cambian y quitan dueños y externo, solo para HOY o MAÑANA (hora del servidor): un día pasado
    // queda como se planificó. La tablet lee solo el de hoy (nunca el de mañana) y no escribe. La revisión de cada ítem la hace la app
    // (core/plan.js: las reglas no recorren listas); aquí, la forma.
    function planValido(fecha) {
      return fechaValida(fecha)
        && nuevo().keys().hasOnly(['fecha', 'items', 'nota', 'por', 'quien', 'en'])
        && nuevo().keys().hasAll(['fecha', 'items', 'por', 'quien', 'en'])
        && nuevo().fecha == fecha
        && nuevo().items is list && nuevo().items.size() >= 1 && nuevo().items.size() <= 60
        && (!('nota' in nuevo()) || texto(nuevo().nota, 1, 200))
        && nuevo().por == request.auth.uid
        && texto(nuevo().quien, 1, 60)
        && nuevo().en == request.time;
    }
    function hoyOManana(fecha) { return esHoy(fecha) || esManana(fecha); }
    match /planes/{fecha} {
      allow read: if esGestion() || (esPesaje() && esHoy(fecha));
      allow create, update: if esGestion() && hoyOManana(fecha) && planValido(fecha);
      allow delete: if esGestion() && hoyOManana(fecha);
    }
    // ---------- Cobros, abonos y cotizaciones (Fase 12). Solo dueños y externo: la cuenta de pesaje no lee ni escribe nada de esto ----------
    // El cobro es un documento interno (no tributario). El número correlativo (folio) sale de config/folios: el cobro o la cotización se crea
    // en la MISMA transacción que sube el folio en uno (getAfter), con el id igual al número de 4 cifras. Así dos equipos no pueden sacar el
    // mismo número: el segundo encuentra el documento ya creado o el folio ya subido, y su transacción se rechaza (la app la reintenta).
    // Lo emitido queda fijo; lo abonado y el saldo no se guardan en el cobro: se calculan con los abonos. Nada de esto se borra.
    function textoOpc(v, max) { return v is string && v.size() <= max; }
    function cuatro(n) { return n < 10 ? '000' + string(n) : n < 100 ? '00' + string(n) : n < 1000 ? '0' + string(n) : string(n); }
    function folioAntes(campo) { return resource == null ? 0 : resource.data[campo]; }
    function folioViejo(campo) {
      return exists(/databases/$(database)/documents/config/folios) ? get(/databases/$(database)/documents/config/folios).data[campo] : 0;
    }
    function folioNuevo(campo) { return getAfter(/databases/$(database)/documents/config/folios).data[campo]; }
    function conFolio(n, campo) {
      return nuevo().numero is int && nuevo().numero == folioNuevo(campo) && folioNuevo(campo) == folioViejo(campo) + 1 && n == cuatro(nuevo().numero);
    }
    function aNombre() { return nuevo().por == request.auth.uid && texto(nuevo().quien, 1, 60) && nuevo().en == request.time; }
    function sello(m) {
      return m is map && m.keys().hasOnly(['por', 'quien', 'en']) && m.keys().hasAll(['por', 'quien', 'en'])
        && m.por == request.auth.uid && texto(m.quien, 1, 60) && m.en == request.time;
    }
    function anulacion(a) {
      return a is map && a.keys().hasOnly(['motivo', 'reemplazo', 'por', 'quien', 'en']) && a.keys().hasAll(['motivo', 'por', 'quien', 'en'])
        && texto(a.motivo, 3, 200) && a.por == request.auth.uid && texto(a.quien, 1, 60) && a.en == request.time
        && (!('reemplazo' in a) || a.reemplazo == null || a.reemplazo is int);
    }
    function descuentoValido(d) { return d == null || (d is map && d.tipo in ['pct', 'monto'] && d.valor is number && d.valor > 0); }
    // Datos de la panadería para los documentos: razón social y RUT obligatorios; lo demás puede quedar vacío.
    match /config/empresa {
      allow read: if esGestion();
      allow create, update: if esGestion()
        && nuevo().keys().hasOnly(['razonSocial', 'rut', 'direccion', 'correo', 'banco', 'tipoCuenta', 'cuenta', 'rutCuenta', 'correoAviso', 'por', 'quien', 'en'])
        && nuevo().keys().hasAll(['razonSocial', 'rut', 'direccion', 'correo', 'banco', 'tipoCuenta', 'cuenta', 'rutCuenta', 'correoAviso', 'por', 'quien', 'en'])
        && texto(nuevo().razonSocial, 1, 100) && texto(nuevo().rut, 3, 12)
        && textoOpc(nuevo().direccion, 150) && textoOpc(nuevo().correo, 100) && textoOpc(nuevo().banco, 60) && textoOpc(nuevo().tipoCuenta, 40)
        && textoOpc(nuevo().cuenta, 30) && textoOpc(nuevo().rutCuenta, 12) && textoOpc(nuevo().correoAviso, 100)
        && aNombre();
      allow delete: if false;
    }
    // Último número usado de cobros y de cotizaciones: solo sube de a uno, y junto con el documento de ese número (que aún no existía).
    match /config/folios {
      allow read: if esGestion();
      allow create, update: if esGestion()
        && nuevo().keys().hasOnly(['cobro', 'cotizacion']) && nuevo().keys().hasAll(['cobro', 'cotizacion'])
        && nuevo().cobro is int && nuevo().cotizacion is int && nuevo().cobro <= 9999 && nuevo().cotizacion <= 9999
        && ((nuevo().cobro == folioAntes('cobro') + 1 && nuevo().cotizacion == folioAntes('cotizacion')
              && !exists(/databases/$(database)/documents/cobros/$(cuatro(nuevo().cobro)))
              && existsAfter(/databases/$(database)/documents/cobros/$(cuatro(nuevo().cobro))))
          || (nuevo().cotizacion == folioAntes('cotizacion') + 1 && nuevo().cobro == folioAntes('cobro')
              && !exists(/databases/$(database)/documents/cotizaciones/$(cuatro(nuevo().cotizacion)))
              && existsAfter(/databases/$(database)/documents/cotizaciones/$(cuatro(nuevo().cotizacion)))));
      allow delete: if false;
    }
    // Datos de cobro de un cliente: aparte de `clientes` porque la tablet lee `clientes` (así nunca ve RUT, descuentos ni montos).
    match /clientesCobro/{id} {
      allow read: if esGestion();
      allow create, update: if esGestion()
        && nuevo().keys().hasOnly(['razonSocial', 'rut', 'direccion', 'contacto', 'periodo', 'plazo', 'descuento', 'por', 'en'])
        && nuevo().keys().hasAll(['razonSocial', 'rut', 'direccion', 'contacto', 'periodo', 'plazo', 'descuento', 'por', 'en'])
        && textoOpc(nuevo().razonSocial, 100) && textoOpc(nuevo().rut, 12) && textoOpc(nuevo().direccion, 150) && textoOpc(nuevo().contacto, 100)
        && nuevo().periodo in ['semana', 'mes']
        && nuevo().plazo is int && nuevo().plazo >= 0 && nuevo().plazo <= 90
        && descuentoValido(nuevo().descuento)
        && existsAfter(/databases/$(database)/documents/clientes/$(id))
        && nuevo().por == request.auth.uid && nuevo().en == request.time;
      allow delete: if false;
    }
    function cobroValido(n) {
      return nuevo().keys().hasOnly(['numero', 'clienteId', 'cliente', 'emisor', 'fecha', 'desde', 'hasta', 'periodo', 'lineas', 'anexo', 'neto', 'descuento', 'netoFinal',
          'iva', 'ivaMonto', 'total', 'ajuste', 'plazo', 'vence', 'factura', 'anulado', 'reemplaza', 'por', 'quien', 'en'])
        && nuevo().keys().hasAll(['numero', 'clienteId', 'cliente', 'emisor', 'fecha', 'desde', 'hasta', 'periodo', 'lineas', 'anexo', 'neto', 'descuento', 'netoFinal',
          'iva', 'ivaMonto', 'total', 'ajuste', 'plazo', 'vence', 'factura', 'anulado', 'reemplaza', 'por', 'quien', 'en'])
        && conFolio(n, 'cobro')
        && texto(nuevo().clienteId, 1, 60) && exists(/databases/$(database)/documents/clientes/$(nuevo().clienteId))
        && nuevo().cliente is map && nuevo().emisor is map && texto(nuevo().emisor.razonSocial, 1, 100) && texto(nuevo().emisor.rut, 3, 12)
        && fechaValida(nuevo().fecha) && fechaValida(nuevo().desde) && fechaValida(nuevo().hasta) && fechaValida(nuevo().vence)
        && nuevo().desde <= nuevo().hasta && nuevo().desde >= '2026-11-01'
        && nuevo().periodo in ['semana', 'mes', 'otro']
        && nuevo().lineas is list && nuevo().lineas.size() >= 1 && nuevo().lineas.size() <= 60
        && nuevo().anexo is list && nuevo().anexo.size() <= 62
        && nuevo().neto is int && nuevo().neto >= 0 && nuevo().netoFinal is int && nuevo().netoFinal >= 0 && nuevo().netoFinal <= nuevo().neto
        && descuentoValido(nuevo().descuento)
        && nuevo().iva is number && nuevo().iva >= 0 && nuevo().iva <= 100
        && nuevo().ivaMonto is int && nuevo().ivaMonto >= 0 && nuevo().total == nuevo().netoFinal + nuevo().ivaMonto && nuevo().ajuste is int
        && nuevo().plazo is int && nuevo().plazo >= 0 && nuevo().plazo <= 90
        && (nuevo().factura == null || texto(nuevo().factura, 1, 30))
        && nuevo().anulado == null && (nuevo().reemplaza == null || nuevo().reemplaza is int)
        && aNombre();
    }
    match /cobros/{n} {
      allow read: if esGestion();
      allow create: if esGestion() && cobroValido(n);
      // Emitido, queda fijo: solo cambian el n.º de factura SII y la anulación (una vez, con motivo: es final).
      allow update: if esGestion() && resource.data.anulado == null
        && nuevo().diff(resource.data).affectedKeys().hasOnly(['factura', 'anulado'])
        && (nuevo().factura == null || texto(nuevo().factura, 1, 30))
        && (nuevo().anulado == null || anulacion(nuevo().anulado));
      allow delete: if false;
    }
    // Abono (pago total o parcial de la cuenta de un cliente): aplicado = [{ cobro, monto }] (hasta 30) y aFavor (lo que sobra). Que la suma
    // cuadre con el monto lo revisa la app (core/abonos.js: las reglas no recorren listas); aquí, la forma. Mientras no esté anulado se
    // puede cambiar el reparto; anularlo es una vez, con motivo. No se borra.
    function repartoValido(a) { return a.aplicado is list && a.aplicado.size() <= 30 && a.aFavor is int && a.aFavor >= 0 && a.aFavor <= a.monto; }
    match /abonos/{id} {
      allow read: if esGestion();
      allow create: if esGestion()
        && nuevo().keys().hasOnly(['clienteId', 'fecha', 'monto', 'medio', 'nota', 'aplicado', 'aFavor', 'anulado', 'reparto', 'por', 'quien', 'en'])
        && nuevo().keys().hasAll(['clienteId', 'fecha', 'monto', 'medio', 'nota', 'aplicado', 'aFavor', 'anulado', 'reparto', 'por', 'quien', 'en'])
        && texto(nuevo().clienteId, 1, 60) && exists(/databases/$(database)/documents/clientes/$(nuevo().clienteId))
        && fechaValida(nuevo().fecha)
        && nuevo().monto is int && nuevo().monto > 0 && nuevo().monto <= 10000000000
        && nuevo().medio in ['transferencia', 'efectivo', 'cheque', 'otro']
        && textoOpc(nuevo().nota, 120)
        && repartoValido(nuevo())
        && nuevo().anulado == null && nuevo().reparto == null
        && aNombre();
      allow update: if esGestion() && resource.data.anulado == null
        && nuevo().diff(resource.data).affectedKeys().hasOnly(['aplicado', 'aFavor', 'reparto', 'anulado'])
        && repartoValido(nuevo())
        && (nuevo().reparto == null || nuevo().reparto == resource.data.reparto || sello(nuevo().reparto))
        && (nuevo().anulado == null || anulacion(nuevo().anulado));
      allow delete: if false;
    }
    // Cotización a un posible cliente: fija al emitirla; después solo cambian el estado y el cliente creado con sus precios (una vez).
    function cotizacionValida(n) {
      return nuevo().keys().hasOnly(['numero', 'para', 'baseClienteId', 'cantidadesPor', 'lineas', 'descuento', 'neto', 'netoFinal', 'iva', 'ivaMonto', 'total', 'ajuste',
          'fecha', 'validaHasta', 'estado', 'clienteId', 'cambio', 'emisor', 'por', 'quien', 'en'])
        && nuevo().keys().hasAll(['numero', 'para', 'baseClienteId', 'cantidadesPor', 'lineas', 'descuento', 'neto', 'netoFinal', 'iva', 'ivaMonto', 'total', 'ajuste',
          'fecha', 'validaHasta', 'estado', 'clienteId', 'cambio', 'emisor', 'por', 'quien', 'en'])
        && conFolio(n, 'cotizacion')
        && nuevo().para is map && texto(nuevo().para.nombre, 1, 60)
        && (nuevo().baseClienteId == null || texto(nuevo().baseClienteId, 1, 60))
        && nuevo().cantidadesPor in ['semana', 'mes']
        && nuevo().lineas is list && nuevo().lineas.size() >= 1 && nuevo().lineas.size() <= 60
        && descuentoValido(nuevo().descuento)
        && nuevo().iva is number && nuevo().iva >= 0 && nuevo().iva <= 100 && nuevo().ajuste is int
        && (nuevo().total == null || (nuevo().netoFinal is int && nuevo().ivaMonto is int && nuevo().total == nuevo().netoFinal + nuevo().ivaMonto))
        && fechaValida(nuevo().fecha) && fechaValida(nuevo().validaHasta) && nuevo().validaHasta >= nuevo().fecha
        && nuevo().estado == 'enviada' && nuevo().clienteId == null && nuevo().cambio == null
        && nuevo().emisor is map
        && aNombre();
    }
    match /cotizaciones/{n} {
      allow read: if esGestion();
      allow create: if esGestion() && cotizacionValida(n);
      allow update: if esGestion()
        && nuevo().diff(resource.data).affectedKeys().hasOnly(['estado', 'clienteId', 'cambio'])
        && nuevo().estado in ['enviada', 'aceptada', 'rechazada']
        && (resource.data.clienteId == null || nuevo().clienteId == resource.data.clienteId)
        && (nuevo().clienteId == null || (nuevo().estado == 'aceptada' && texto(nuevo().clienteId, 1, 60)
          && existsAfter(/databases/$(database)/documents/clientes/$(nuevo().clienteId))))
        && sello(nuevo().cambio);
      allow delete: if false;
    }
    // Bitácora de correcciones: se agrega junto con cada corrección, anulación o reactivación de un pesaje; nunca se cambia ni se borra.
    // La tablet deja constancia solo de lo del día. `quien` (opcional, Fase 5): nombre de la cuenta, para el registro general.
    // Revisión del 25-nov-2026: la constancia debe apuntar a un canasto que existe (la app la guarda en el mismo lote que la corrección, así
    // que el canasto ya está) y la tablet, además, solo de un canasto cuya fecha sea la de la constancia; `antes` y `despues` no pasan de
    // 12 campos (un pesaje tiene 11). Lo que las reglas no pueden exigir es que cada corrección TRAIGA su constancia: eso lo hace la app.
    match /cambios/{id} {
      allow read: if esGestion();
      allow create: if conAcceso()
        && nuevo().keys().hasOnly(['tipo', 'pesajeId', 'fecha', 'antes', 'despues', 'por', 'quien', 'en'])
        && nuevo().keys().hasAll(['tipo', 'pesajeId', 'fecha', 'antes', 'despues', 'por', 'en'])
        && nuevo().tipo in ['corregir', 'anular', 'reactivar']
        && texto(nuevo().pesajeId, 1, 60)
        && fechaValida(nuevo().fecha)
        && nuevo().antes is map && nuevo().despues is map
        && nuevo().antes.keys().size() <= 12 && nuevo().despues.keys().size() <= 12
        && nuevo().por == request.auth.uid
        && (!('quien' in nuevo()) || texto(nuevo().quien, 1, 60))
        && nuevo().en == request.time
        && exists(/databases/$(database)/documents/pesajes/$(nuevo().pesajeId))
        && (esGestion() || (esHoy(nuevo().fecha)
          && get(/databases/$(database)/documents/pesajes/$(nuevo().pesajeId)).data.fecha == nuevo().fecha));
      allow update, delete: if false;
    }
  }
}
